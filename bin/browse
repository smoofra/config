#!/usr/bin/env python3

import tempfile
import webbrowser
import argparse
import sys
import os
import time

def main():
    parser = argparse.ArgumentParser()
    parser.parse_args()

    t = tempfile.NamedTemporaryFile(mode="w+", encoding="utf8", suffix=".html", delete=False) 
    with t as out:
        out.write(sys.stdin.read())
        webbrowser.open_new("file://" + os.path.abspath(out.name))

if __name__ == "__main__":
    main()