#!/bin/bash

if ! [ -e /data/Backup ]; then
	exit 0
fi


logfile="$HOME/log/vdirsyncer `date -R`"

( yes | vdirsyncer discover >"$logfile" 2>&1 && \
  yes | vdirsyncer metasync >>"$logfile" 2>&1 && \
  yes | vdirsyncer sync >>"$logfile" 2>&1 && \
  yes | vdirsyncer sync >>"$logfile" 2>&1 ) || cat "$logfile"




