#!/usr/bin/env python3
import argparse
import subprocess
import shlex

def run(args, dry_run=False):
    print("+", " ".join(map(shlex.quote, args)))
    if not dry_run:
        subprocess.run(args, check=True)


def main():
    parser = argparse.ArgumentParser(description="Delete a local branch and its upstream")
    parser.add_argument("branch", help="Branch to delete")
    parser.add_argument("-n", "--dry-run", action="store_true", help="Print commands without executing")
    args = parser.parse_args()

    upstream = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", f"{args.branch}@{{upstream}}"],
        check=True, text=True, capture_output=True).stdout.strip()

    remote, remote_branch = upstream.split("/", 1)

    run(["git", "branch", "-D", args.branch], dry_run=args.dry_run)
    run(["git", "push", remote, "--delete", remote_branch], dry_run=args.dry_run)


if __name__ == "__main__":
    main()
