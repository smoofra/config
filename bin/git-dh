#!/usr/bin/env python3

import argparse
import re
import subprocess
import sys


def revparse(name):
    result = subprocess.run(
        ["git", "rev-parse", "--short", "--revs-only", name],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        sys.exit(f"git rev-parse {name} failed:\n{result.stderr}")
    hash_ = result.stdout.strip()
    if hash_ == "":
        sys.exit(f"bad revision: {name}")
    if not re.fullmatch(r"[0-9a-fA-F]+", hash_):
        sys.exit(f"git rev-parse returned nonsense <{hash_}>")
    return hash_


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-p", dest="plain", action="store_true")
    parser.add_argument("-d", "--decorate", dest="decorate", action="store_true")
    parser.add_argument("-b", "--boundary", dest="boundary", action="store_true")
    parser.add_argument("-g", "--graph", dest="graph", action="store_true")
    parser.add_argument("-a", dest="author", action="store_true")
    parser.add_argument("-m", dest="merges", action="store_true")
    parser.add_argument("refs", nargs="*")
    args = parser.parse_args()

    if args.graph and args.author:
        sys.exit("-g is incompatible with -a")

    if len(args.refs) == 1:
        as_, bs = args.refs[0], "HEAD"
    elif len(args.refs) == 2:
        as_, bs = args.refs
    else:
        sys.exit("usage: git dh <ref1> <ref2>")

    a = revparse(as_)
    b = revparse(bs)

    if not args.plain:
        width = max(len(as_), len(bs))
        print(f"{as_:<{width}} {a}")
        print(f"{bs:<{width}} {b}")
        print()

    if a == b:
        print("same commit")
        return

    sys.stdout.flush()

    log_args = []
    if args.graph:
        log_args += ["--oneline", "--left-right", "--graph"]
    elif args.author:
        log_args += ["--pretty=format:%m%h %an %s"]
    else:
        log_args += ["--left-right", "--oneline"]

    if args.decorate:
        log_args.append("--decorate")
    if not (args.merges or args.graph):
        log_args.append("--no-merges")
    if args.boundary:
        log_args.append("--boundary")
    log_args.append(f"{a}...{b}")

    result = subprocess.run(["git", "log"] + log_args)
    if result.returncode != 0:
        sys.exit("git log failed")

    print()
    if args.author:
        print()
    sys.stdout.flush()

    diff_result = subprocess.run(["git", "diff", "--quiet", a, b])
    if diff_result.returncode > 1:
        sys.exit("git diff failed")
    if diff_result.returncode == 1:
        print("trees differ")
    else:
        print("trees are the same")


if __name__ == "__main__":
    main()
