#!/usr/bin/env python3

import argparse
from contextlib import contextmanager
from typing import NamedTuple, Iterable, Iterator
from collections import namedtuple
import csv
import sys
import json

import prettytable
import pefile

class Export(NamedTuple):
    address: int
    name: str
    ordinal: int

def print_table(rows:Iterable[NamedTuple], format:str|None) -> None:

    if format == "names":
        for row in rows:
            print(getattr(row, "name"))

    elif format == "csv":
        w = csv.writer(sys.stdout)
        w.writerows(rows)

    elif format == "json":

        json.dump([x._asdict() for x in rows], sys.stdout, indent=True)
        sys.stdout.write('\n')

    elif format in ("text", None):

        table = prettytable.PrettyTable(border=False, align="l")
        table.custom_format["address"] = lambda field, value: hex(value)
        table.custom_format["ordinal"] = lambda _, x: str(x) if x is not None else ""
        table.custom_format["hint"] = lambda _, x: str(x) if x is not None else ""

        for row in rows:
            if not table.field_names:
                table.field_names = row._fields
            table.add_row(row)

        print(table)
    else:
        raise Exception(f"unknown format: {format}")


def exports(pe, format:str|None) -> None:
    def i() -> Iterator[Export]:
        symbol : pefile.ExportData
        for symbol in pe.DIRECTORY_ENTRY_EXPORT.symbols:
            address = pe.OPTIONAL_HEADER.ImageBase + symbol.address
            yield Export(address, 
                         (symbol.name or b"").decode('utf8'), 
                         symbol.ordinal)
    print_table(i(), format)


class Import(NamedTuple):
    dll: str
    name: str
    ordinal: int|None = None
    hint: int|None = None

def imports(pe, format:str|None) -> None:
    def i() -> Iterator[NamedTuple]:
        module: pefile.ImportDescData
        for module in pe.DIRECTORY_ENTRY_IMPORT:
            for symbol in module.imports:
                if symbol.import_by_ordinal:
                    yield Import(
                        module.dll.decode('utf8'),
                        (symbol.name or b"" ).decode("utf8"), 
                        ordinal=symbol.ordinal) # type: ignore
                else:
                    yield Import(
                        module.dll.decode('utf8'), 
                        (symbol.name or b"" ).decode("utf8"), 
                        hint=symbol.hint)
    print_table(i(), format)


def main():

    from signal import signal, SIGPIPE, SIG_DFL
    signal(SIGPIPE, SIG_DFL)

    parser = argparse.ArgumentParser()
    parser.add_argument("--exports", "-e", action="store_true")
    parser.add_argument("--imports", "-i", action="store_true")
    parser.add_argument("--format", "-f")
    parser.add_argument("file")
    args = parser.parse_args()

    pe = pefile.PE(args.file)
    if args.exports:
        exports(pe, args.format)
    elif args.imports:
        imports(pe, args.format)
    else:
        print(pe.dump_info())

if __name__ == '__main__':
    main()